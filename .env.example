# Copy to .env and fill in. Never commit .env. Full reference: docs/SPEC.md, section 6.

# --- Django ---
# Development values. Production values: docs/SPEC.md, section 6 (docs/deploy.md later).
# `make setup` writes a new random key here when it creates .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The compose.dev.yml database (`make db`). PostgreSQL only: the job queue uses SKIP LOCKED.
DATABASE_URL=postgres://ohw:ohw@localhost:5432/ohw
TIME_ZONE=Asia/Tashkent
# Uploaded files; a relative path is under the repository (production: /data/media).
MEDIA_ROOT=media

# --- Judge worker ---
JUDGE_NODE_NAME=node-1
# Parallel check slots per lane. Scaling the server changes only this value.
JUDGE_SLOTS=heavy:1,fast:1
# RAM left for the site and the database; the worker checks that slots fit into the rest.
JUDGE_RESERVED_MEMORY_MB=3072
JUDGE_CPU_SHARES=512
# runc now; runsc (gVisor) later.
JUDGE_RUNTIME=runc
JUDGE_POLL_INTERVAL_S=1
JUDGE_LEASE_S=60
JUDGE_MAX_OUTPUT_KB=512

# --- Submissions ---
SUBMISSION_COOLDOWN_S=60
SUBMISSION_MAX_ACTIVE_PER_STUDENT=1
SUBMISSION_MAX_ZIP_MB=5
# Unpacked size and file count count only the files taken from the zip.
SUBMISSION_MAX_UNPACKED_MB=20
SUBMISSION_MAX_FILES=500
TASK_MAX_ZIP_MB=50
TASK_MAX_UNPACKED_MB=200
TASK_MAX_FILES=5000

# --- Base images (make base-images) ---
# Official dart:<version> image for the dart profile.
DART_VERSION=3.13.5
# Exact Flutter stable release the flutter base image is built from.
FLUTTER_VERSION=3.47.5

# --- Production only (compose.prod.yml, docs/deploy.md) ---
# `scripts/create-env.sh --production DOMAIN` fills these in and switches the values above.
#SITE_DOMAIN=
#POSTGRES_PASSWORD=
# Group id of /var/run/docker.sock on the host: the worker joins it to start containers.
#DOCKER_GID=
#GUNICORN_CMD_ARGS=--workers 3 --timeout 120
# Caddy's request size limit; keep it above TASK_MAX_ZIP_MB.
#UPLOAD_MAX_BODY=60MB
# The superadmin panel's private door (docs/deploy.md): Caddy sends it, Django checks it.
# Empty in production: the panel stays closed. Not needed while DJANGO_DEBUG=true.
#ADMIN_GATE_SECRET=
