# Copy to .env and fill in. Never commit .env. Full reference: docs/SPEC.md, section 6.

# --- Django (Phase 1) ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=
DATABASE_URL=postgres://ohw:ohw@db:5432/ohw
TIME_ZONE=Asia/Tashkent
MEDIA_ROOT=/data/media

# --- Judge worker ---
JUDGE_NODE_NAME=node-1
# Parallel check slots per lane. Scaling the server changes only this value.
JUDGE_SLOTS=heavy:1,fast:1
# RAM left for the site and the database; the worker checks that slots fit into the rest.
JUDGE_RESERVED_MEMORY_MB=3072
JUDGE_CPU_SHARES=512
# runc now; runsc (gVisor) later.
JUDGE_RUNTIME=runc
JUDGE_POLL_INTERVAL_S=1
JUDGE_LEASE_S=60
JUDGE_MAX_OUTPUT_KB=512

# --- Submissions ---
SUBMISSION_COOLDOWN_S=60
SUBMISSION_MAX_ACTIVE_PER_STUDENT=1
SUBMISSION_MAX_ZIP_MB=5
TASK_MAX_ZIP_MB=50

# Exact Flutter release tag the flutter base image is built with (e.g. a stable tag).
FLUTTER_VERSION=
